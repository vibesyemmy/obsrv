{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "rootDir": "src",
    "outDir": "out",
    "declaration": false,
    "sourceMap": false
  },
  // `bin/uninstall.js` is plain Node and requires these three out of `out/`:
  // the CLI's own build runs under Electron, and a person removing Obsrv
  // should not need Electron to be told where its data is.
  "include": ["src/mcp/**/*", "src/shared/uninstallPlan.ts", "src/shared/removalGuard.ts", "src/shared/uninstallReport.ts"]
}
