node_modules/
out/
dist/
test-results/
playwright-report/
.vitest/
.DS_Store
*.tsbuildinfo
# No rule for stray `obsrv-*/` directories: every mkdtemp in this repo roots
# at os.tmpdir(), so one appearing here is a bug (1,401 of them accumulated
# under the old rule, unnoticed). Leave them visible in `git status`.
node-compile-cache/
playwright-transform-cache-*/
tsx-*/
playwright-artifacts-*/
obsrv-*.png
getobsrv-*.tgz

# Vitest browser-mode failure screenshots.
tests/browser/__screenshots__/

# Local agent configuration, never the repository's business. CLAUDE.md and
# .claude/ were committed once by a careless `git add -A` (9488c44) and
# removed in the commit that added these lines; ignoring them is what stops
# that recurring.
/CLAUDE.md
/.claude/

# Subagent-driven-development scratch: ledgers, briefs, review packages.
.superpowers/

# Temp dirs a test run leaves in the working tree when TMPDIR points here
# (the agent sandbox sets it to the repo root); the unit tests clean up after
# themselves, so anything left is a crashed run's.
obsrv-*/

# The suite lock (scripts/suiteLock.js): one running suite per worktree.
.obsrv-suite.lock/

# Generated from board/ by scripts/build-board.js. Not committed since
# 2026-09-15: every branch touching any card conflicted with every other on
# these two derived files, always resolved by regenerating. Run `npm run board`
# to build them locally; pages.yml publishes them from main on every push.
docs/board.md
docs/board.html
